{
  "name": "rusty-ventures",
  "version": "0.2.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run build-wasm-safe && next build",
    "build-no-wasm": "next build",
    "build-wasm": "wasm-pack build --target web --out-dir ../public/wasm rust",
    "build-wasm-safe": "npm run build-wasm || echo 'WASM build failed, using pre-built files'",
    "start": "next start",
    "lint": "eslint src"
  },
  "dependencies": {
    "@codemirror/lang-rust": "^6.0.2",
    "@uiw/react-codemirror": "^4.25.11",
    "next": "16.2.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.5.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.12",
    "postcss": "^8.5.25",
    "tailwindcss": "^4.3.3",
    "typescript": "^5",
    "wasm-pack": "^0.15.0"
  },
  "overrides": {
    "axios": "^1.7.7"
  },
  "engines": {
    "node": ">=24"
  }
}
